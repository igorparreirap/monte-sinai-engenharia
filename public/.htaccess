# Configuração para hospedagem Apache (HostGator).
Options -Indexes

# Bloqueia o acesso aos arquivos de controle do deploy (lista de arquivos e hashes).
<FilesMatch "^\.ftp-deploy-.*\.json$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Força HTTPS. Desativado até o certificado SSL (AutoSSL) ser emitido para o
  # domínio; sem certificado, o redirecionamento leva à página 404 da hospedagem.
  # Reativar removendo os "#" das duas linhas abaixo (issue #2).
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Arquivos com hash no nome (gerados pelo Vite) podem ficar em cache por 1 ano.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
